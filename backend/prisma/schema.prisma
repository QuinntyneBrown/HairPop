generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  braider
}

model User {
  id              String    @id @default(cuid())
  name            String
  /// Stored normalized: trimmed and lower-cased.
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  role            Role      @default(customer)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
}

/// A signed-in browser (ADR 0008). The cookie holds an opaque token; only its SHA-256 is stored.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Fixed-window counters for abuse controls (L2-040).
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime
}

/// A visitor's saved optional-usage choice (L2-034). Kept as a record of each save; it holds no identity.
model ConsentPreference {
  id            String   @id @default(cuid())
  optionalUsage Boolean
  savedAt       DateTime @default(now())
}

/// Help, Terms and Privacy copy (L2-032, L2-033). `sections` is [{ id, heading, paragraphs[] }].
model ContentPage {
  slug          String    @id
  title         String
  effectiveDate DateTime? @db.Date
  sections      Json
  supportEmail  String?
  published     Boolean   @default(false)
  updatedAt     DateTime  @updatedAt
}
