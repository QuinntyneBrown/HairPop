generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  braider
}

model User {
  id              String                 @id @default(cuid())
  name            String
  /// Stored normalized: trimmed and lower-cased.
  email           String                 @unique
  emailVerifiedAt DateTime?
  /// A changed email waiting for its verification link (L2-014); normalized like `email`.
  pendingEmail    String?
  phone           String?
  passwordHash    String
  role            Role                   @default(customer)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sessions        Session[]
  braider         Braider?
  reviews         Review[]
  reviewReports   ReviewReport[]
  appointments    Appointment[]
  verifications   EmailVerification[]
  passwordResets  PasswordReset[]
  notifications   CustomerNotification[]
}

/// A single-use email verification link (L2-013). Only the SHA-256 of the token is stored (L2-039).
model EmailVerification {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The address the link verifies: the account email or its pending replacement.
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A single-use password reset link (L2-012). Only the SHA-256 of the token is stored (L2-039).
model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// An email waiting for the worker (ADR 0009). The text is cleared once it is delivered.
model OutboundEmail {
  id            String    @id @default(cuid())
  to            String
  subject       String
  text          String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([sentAt, nextAttemptAt])
}

/// An update in the customer's notification center (L2-029, L2-030).
model CustomerNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// An app path such as /appointments/HP-1048, or null when there is no destination.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// A signed-in browser (ADR 0008). The cookie holds an opaque token; only its SHA-256 is stored.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Fixed-window counters for abuse controls (L2-040).
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime
}

/// A visitor's saved optional-usage choice (L2-034). Kept as a record of each save; it holds no identity.
model ConsentPreference {
  id            String   @id @default(cuid())
  optionalUsage Boolean
  savedAt       DateTime @default(now())
}

/// Help, Terms and Privacy copy (L2-032, L2-033). `sections` is [{ id, heading, paragraphs[] }].
model ContentPage {
  slug          String    @id
  title         String
  effectiveDate DateTime? @db.Date
  sections      Json
  supportEmail  String?
  published     Boolean   @default(false)
  updatedAt     DateTime  @updatedAt
}

enum StyleCategory {
  braids
  twists
  locs
}

/// A published hairstyle (L2-001 – L2-003). Ranges are stored as min/max pairs; a null min means "not known".
model Style {
  slug            String           @id
  name            String
  category        StyleCategory
  eyebrow         String
  imageSrc        String?
  imageAlt        String?
  typicalHoursMin Float?
  typicalHoursMax Float?
  /// Whole dollars.
  typicalPriceMin Int?
  typicalPriceMax Int?
  intro           String           @default("")
  /// Weeks.
  typicalWearMin  Int?
  typicalWearMax  Int?
  /// [{ name, description }]
  variations      Json             @default("[]")
  quoteFactors    String[]         @default([])
  published       Boolean          @default(false)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  services        BraiderService[]

  @@index([published, sortOrder])
}

/// A braider's public profile. Studio address and contact details never leave the API publicly (L2-039).
model Braider {
  id                 String           @id @default(cuid())
  slug               String           @unique
  userId             String?          @unique
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name               String
  photoSrc           String?
  photoAlt           String?
  /// Public service area, such as "Toronto West".
  area               String
  /// Distance from central Toronto, used by the matching distance filter (L2-005).
  distanceKm         Float
  /// How far the braider travels to a customer, when they do.
  travelKm           Int?
  bio                String           @default("")
  studioAddress      String?
  preparationPolicy  String?
  changePolicy       String?
  cancellationPolicy String?
  published          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  services           BraiderService[]
  slots              OfferedSlot[]
  reviews            Review[]
  portfolio          PortfolioItem[]
  appointments       Appointment[]
}

/// A style a braider offers, with their starting price (whole dollars) and typical hours.
model BraiderService {
  id            String        @id @default(cuid())
  braiderId     String
  braider       Braider       @relation(fields: [braiderId], references: [id], onDelete: Cascade)
  styleSlug     String
  style         Style         @relation(fields: [styleSlug], references: [slug])
  name          String
  startingPrice Int
  typicalHours  Float
  /// Service-specific preparation shown on the customer's checklist (L2-024, L2-026).
  preparation   String?
  /// Aftercare the braider gives for this service, one item each (L2-024 AC2).
  careGuidance  String[]      @default([])
  published     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  reviews       Review[]
  appointments  Appointment[]

  @@index([styleSlug, published])
  @@index([braiderId])
}

/// A start time the braider offers for requests.
model OfferedSlot {
  id           String              @id @default(cuid())
  braiderId    String
  braider      Braider             @relation(fields: [braiderId], references: [id], onDelete: Cascade)
  start        DateTime
  maxHours     Float
  createdAt    DateTime            @default(now())
  appointments Appointment[]
  changes      AppointmentChange[]

  @@index([braiderId, start])
}

/// `completed` is not stored: a confirmed appointment is completed once its time has passed.
enum AppointmentStatus {
  awaiting_reply
  confirmed
  declined
  cancelled
}

/// A booking request and, once the braider accepts it, the appointment (L2-017 – L2-022). It
/// snapshots the service, estimate and policies the customer reviewed (L2-026 AC3, L2-027 AC2).
model Appointment {
  id                 String              @id @default(cuid())
  /// Shown as the reference HP-1048; the sequence starts at 1001.
  number             Int                 @unique @default(autoincrement())
  customerId         String
  customer           User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  braiderId          String
  braider            Braider             @relation(fields: [braiderId], references: [id], onDelete: Cascade)
  serviceId          String
  service            BraiderService      @relation(fields: [serviceId], references: [id])
  slotId             String?
  slot               OfferedSlot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)
  /// The slot while the request or appointment is active; unique, so one slot holds one booking.
  heldSlotId         String?             @unique
  serviceName        String
  start              DateTime
  durationHours      Float
  /// Whole dollars. A null maximum means "from" the minimum.
  estimateMin        Int
  estimateMax        Int?
  agreedAmount       Int?
  email              String
  phone              String?
  hairDetails        String
  policyVersion      String
  changePolicy       String
  cancellationPolicy String
  status             AppointmentStatus   @default(awaiting_reply)
  /// Bumped on every transition; a response must name the version it saw (L2-020 AC3).
  version            Int                 @default(1)
  idempotencyKey     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  changes            AppointmentChange[]
  review             Review?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, start])
  @@index([braiderId, status])
}

enum ReviewStatus {
  published
  pending
  removed
}

/// A customer's review of a visit. Only published reviews are public or rated (L2-008).
model Review {
  id             String         @id @default(cuid())
  braiderId      String
  braider        Braider        @relation(fields: [braiderId], references: [id], onDelete: Cascade)
  serviceId      String
  service        BraiderService @relation(fields: [serviceId], references: [id])
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  /// The visit reviewed; one review per appointment (L2-025 AC4). Older reviews may have none.
  appointmentId  String?        @unique
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  idempotencyKey String?
  rating         Int
  text           String
  status         ReviewStatus   @default(pending)
  createdAt      DateTime       @default(now())
  reports        ReviewReport[]

  @@index([braiderId, status, createdAt])
}

enum ReportReason {
  not_real_visit
  offensive
  private_info
  other
}

enum ReportStatus {
  open
  upheld
  dismissed
}

/// A customer's report of a published review, waiting for moderation (L2-009). It never changes
/// the review by itself.
model ReviewReport {
  id         String       @id @default(cuid())
  reviewId   String
  review     Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())

  @@unique([reviewId, reporterId])
}

/// A photo of the braider's work on their public profile; newest first.
model PortfolioItem {
  id        String   @id @default(cuid())
  braiderId String
  braider   Braider  @relation(fields: [braiderId], references: [id], onDelete: Cascade)
  imageSrc  String?
  imageAlt  String?
  caption   String
  createdAt DateTime @default(now())

  @@index([braiderId, createdAt])
}

enum ChangeStatus {
  pending
  accepted
  declined
  withdrawn
}

/// A customer's proposed new time (L2-021). The appointment keeps its time until the braider
/// accepts; at most one change per appointment is pending.
model AppointmentChange {
  id            String       @id @default(cuid())
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  slotId        String?
  slot          OfferedSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  /// The proposed slot while the change is pending; unique, so one slot holds one change.
  heldSlotId    String?      @unique
  start         DateTime
  note          String?
  status        ChangeStatus @default(pending)
  createdAt     DateTime     @default(now())
  decidedAt     DateTime?

  @@index([appointmentId, status])
}
