# Used by `npm run dev` and Prisma CLI commands.
DATABASE_URL=postgresql://hairpop:hairpop@localhost:5433/hairpop
# Used by `npm test`: the test server and factories use this database. Tests truncate it.
TEST_DATABASE_URL=postgresql://hairpop:hairpop@localhost:5433/hairpop_test
# Customer app origin for links in emails.
APP_ORIGIN=http://localhost:4200
# Used by `npm run worker` to deliver queued emails (ADR 0009); docker compose runs Mailpit.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=HairPop <no-reply@hairpop.example>
