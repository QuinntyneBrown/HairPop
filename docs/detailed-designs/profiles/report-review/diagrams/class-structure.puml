}
title Class structure — Report review
class ReportPublishedReview {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class ReviewReport {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): ReviewReport
  +save(record: ReviewReport): void
}
ReportPublishedReview ..> FeatureRequest : accepts
ReportPublishedReview ..> FeatureResult : returns
ReportPublishedReview ..> FeatureRepository : uses
ReportPublishedReview --> ReviewReport : checks or changes
FeatureRepository ..> ReviewReport : persists
@enduml
