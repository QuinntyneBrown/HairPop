@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Submit booking request
Person(person, "Customer", "Uses this capability")
System_Boundary(hairpop, "HairPop") {
  Container(web, "Customer web application", "Angular", "Presents the workflow")
  Container(api, "HairPop API", "Laravel 11", "Applies application and domain rules")
