title Class structure — Prepare booking request
class PrepareBookingRequest {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class BookingDraft {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): BookingDraft
  +save(record: BookingDraft): void
}
PrepareBookingRequest ..> FeatureRequest : accepts
PrepareBookingRequest ..> FeatureResult : returns
PrepareBookingRequest ..> FeatureRepository : uses
PrepareBookingRequest --> BookingDraft : checks or changes
FeatureRepository ..> BookingDraft : persists
@enduml
