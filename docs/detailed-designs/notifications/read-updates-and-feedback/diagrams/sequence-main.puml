@startuml
title UML sequence behaviour — Read updates and feedback
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Customer" as actor
box "Frontend — Customer web application" #E0F2FE
  participant "NotificationCenterPage" as page
  participant "Feature API client" as client
end box
box "Backend — HairPop API application" #D1FADF
  participant "Feature endpoint" as endpoint
end box
box "Backend — HairPop Application and Domain" #ECFDF3
  participant "ReadCustomerUpdates" as action
  participant "CustomerNotification" as model
end box
box "Backend — HairPop Infrastructure" #FFF4E5
  database "HairPop database" as db
end box
actor -> page : Start read updates and feedback
page -> client : Submit or load current criteria
client -> endpoint : HTTPS request
endpoint -> endpoint : Validate and authorize
endpoint -> action : Execute L2-030, L2-031
action -> db : Read current permitted state
db --> action : Current record or absence
alt Valid and available
  action -> model : Present recent owned records and acknowledge read state with accurate feedback (L2-030, L2-031)
  model --> action : Valid domain result
  action -> db : Persist changed state
  db --> action : Durable result
  action --> endpoint : Successful result
  endpoint --> client : HTTP success
  client --> page : Typed result
  page --> actor : Present current state
else Invalid, unavailable, or forbidden
  action --> endpoint : Failure without unintended change
  endpoint --> client : HTTP error and safe details
  client --> page : Typed error
  page --> actor : Preserve work and show next action
end
@enduml
