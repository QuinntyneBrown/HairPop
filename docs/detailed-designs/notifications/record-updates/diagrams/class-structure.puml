@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Record updates
class RecordCustomerUpdate {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class CustomerNotification {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): CustomerNotification
  +save(record: CustomerNotification): void
}
RecordCustomerUpdate ..> FeatureRequest : accepts
RecordCustomerUpdate ..> FeatureResult : returns
RecordCustomerUpdate ..> FeatureRepository : uses
RecordCustomerUpdate --> CustomerNotification : checks or changes
FeatureRepository ..> CustomerNotification : persists
@enduml
