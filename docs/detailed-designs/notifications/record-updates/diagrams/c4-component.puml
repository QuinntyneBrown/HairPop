@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Record updates
Container_Boundary(api, "HairPop API") {
  Component(endpoint, "Feature endpoint", "Next.js route handler", "Validates HTTP input")
  Component(action, "RecordCustomerUpdate", "Application action", "Create owned notifications from durable account, booking, review and privacy events")
  Component(model, "CustomerNotification", "Domain model", "Holds slice state")
  ComponentDb(db, "HairPop database", "PostgreSQL 16 (Prisma)", "Stores records")
}
Rel(endpoint, action, "Delegates")
Rel(action, model, "Applies rules")
Rel(action, db, "Reads or persists")
@enduml
