@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Request time change
class ProposeAppointmentChange {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class AppointmentChange {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): AppointmentChange
  +save(record: AppointmentChange): void
}
ProposeAppointmentChange ..> FeatureRequest : accepts
ProposeAppointmentChange ..> FeatureResult : returns
ProposeAppointmentChange ..> FeatureRepository : uses
ProposeAppointmentChange --> AppointmentChange : checks or changes
FeatureRepository ..> AppointmentChange : persists
@enduml
