@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View appointments
class ReadOwnedAppointments {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class Appointment {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): Appointment

}
ReadOwnedAppointments ..> FeatureRequest : accepts
ReadOwnedAppointments ..> FeatureResult : returns
ReadOwnedAppointments ..> FeatureRepository : uses
ReadOwnedAppointments --> Appointment : checks or changes
FeatureRepository ..> Appointment : persists
@enduml
