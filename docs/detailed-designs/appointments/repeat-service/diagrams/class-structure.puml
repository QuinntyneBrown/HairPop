@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Repeat service
class PrepareRepeatBooking {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class BookingDraft {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): BookingDraft
  +save(record: BookingDraft): void
}
PrepareRepeatBooking ..> FeatureRequest : accepts
PrepareRepeatBooking ..> FeatureResult : returns
PrepareRepeatBooking ..> FeatureRepository : uses
PrepareRepeatBooking --> BookingDraft : checks or changes
FeatureRepository ..> BookingDraft : persists
@enduml
