@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Maintain services
class MaintainBraiderService {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class BraiderService {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): BraiderService
  +save(record: BraiderService): void
}
MaintainBraiderService ..> FeatureRequest : accepts
MaintainBraiderService ..> FeatureResult : returns
MaintainBraiderService ..> FeatureRepository : uses
MaintainBraiderService --> BraiderService : checks or changes
FeatureRepository ..> BraiderService : persists
@enduml
