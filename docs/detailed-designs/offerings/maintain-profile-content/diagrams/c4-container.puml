@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Maintain profile content
Person(person, "Braider", "Uses this capability")
System_Boundary(hairpop, "HairPop") {
  Container(web, "Braider management surface", "Angular", "Presents the workflow")
  Container(api, "HairPop API", "Node.js 22 / Next.js 15", "Applies application and domain rules")
  ContainerDb(db, "HairPop database", "PostgreSQL 16", "Persists domain records")
}
Rel(person, web, "Uses", "HTTPS")
Rel(web, api, "Requests", "JSON/HTTPS")
Rel(api, db, "Reads and writes")
@enduml
