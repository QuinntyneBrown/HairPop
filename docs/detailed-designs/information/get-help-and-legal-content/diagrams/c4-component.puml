@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Get help and legal content
Container_Boundary(api, "HairPop API") {
  Component(endpoint, "Feature endpoint", "Next.js route handler", "Validates HTTP input")
  Component(action, "GetPublishedContent", "Application action", "Deliver current approved help, terms and privacy text through public pages")
  Component(model, "PublishedContent", "Domain model", "Holds slice state")
  ComponentDb(db, "HairPop database", "PostgreSQL 16 (Prisma)", "Stores records")
}
Rel(endpoint, action, "Delegates")
Rel(action, model, "Applies rules")
Rel(action, db, "Reads or persists")
@enduml
