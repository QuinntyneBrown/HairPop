title Class structure — Inspect style
class GetPublishedStyle {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class Style {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): Style

}
GetPublishedStyle ..> FeatureRequest : accepts
GetPublishedStyle ..> FeatureResult : returns
GetPublishedStyle ..> FeatureRepository : uses
GetPublishedStyle --> Style : checks or changes
FeatureRepository ..> Style : persists
@enduml
