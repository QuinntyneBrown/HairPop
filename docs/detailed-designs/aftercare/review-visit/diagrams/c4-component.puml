@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Review visit
Container_Boundary(api, "HairPop API") {
  Component(endpoint, "Feature endpoint", "Next.js route handler", "Validates HTTP input")
  Component(action, "SubmitVisitReview", "Application action", "Save one valid rating and written review for an owned completed visit")
  Component(model, "Review", "Domain model", "Holds slice state")
