@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Keep workflows responsive and reliable
Container_Boundary(api, "HairPop API") {
  Component(endpoint, "Feature endpoint", "Laravel controller", "Validates HTTP input")
  Component(action, "ExecuteReliableWorkflow", "Application action", "Measure reads, reconcile durable mutations and protect offline appointment summaries")
  Component(model, "OperationRecord", "Domain model", "Holds slice state")
  ComponentDb(db, "HairPop database", "<TO SUPPLY>", "Stores records")
}
Rel(endpoint, action, "Delegates")
Rel(action, model, "Applies rules")
Rel(action, db, "Reads or persists")
@enduml
