@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Keep workflows responsive and reliable
class ExecuteReliableWorkflow {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class OperationRecord {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): OperationRecord
  +save(record: OperationRecord): void
}
ExecuteReliableWorkflow ..> FeatureRequest : accepts
ExecuteReliableWorkflow ..> FeatureResult : returns
ExecuteReliableWorkflow ..> FeatureRepository : uses
ExecuteReliableWorkflow --> OperationRecord : checks or changes
FeatureRepository ..> OperationRecord : persists
@enduml
