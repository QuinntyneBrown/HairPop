@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Manage cookie choice
class SaveOptionalConsent {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class ConsentPreference {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): ConsentPreference
  +save(record: ConsentPreference): void
}
SaveOptionalConsent ..> FeatureRequest : accepts
SaveOptionalConsent ..> FeatureResult : returns
SaveOptionalConsent ..> FeatureRepository : uses
SaveOptionalConsent --> ConsentPreference : checks or changes
FeatureRepository ..> ConsentPreference : persists
@enduml
