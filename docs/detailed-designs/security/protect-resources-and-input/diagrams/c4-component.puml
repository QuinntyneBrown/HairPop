@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Protect resources and input
Container_Boundary(api, "HairPop API") {
  Component(endpoint, "Feature endpoint", "Next.js route handler", "Validates HTTP input")
  Component(action, "AuthorizeAndValidate", "Application action", "Authorize each owned resource, validate untrusted input and enforce configured limits")
  Component(model, "ProtectedResource", "Domain model", "Holds slice state")
  ComponentDb(db, "HairPop database", "PostgreSQL 16 (Prisma)", "Stores records")
}
Rel(endpoint, action, "Delegates")
Rel(action, model, "Applies rules")
Rel(action, db, "Reads or persists")
@enduml
