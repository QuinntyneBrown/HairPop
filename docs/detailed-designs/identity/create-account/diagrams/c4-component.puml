@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Create account
Container_Boundary(api, "HairPop API") {
  Component(endpoint, "Feature endpoint", "Next.js route handler", "Validates HTTP input")
  Component(action, "RegisterCustomer", "Application action", "Normalize the email and create one account with a verification challenge")
  Component(model, "CustomerAccount", "Domain model", "Holds slice state")
  ComponentDb(db, "HairPop database", "PostgreSQL 16 (Prisma)", "Stores records")
}
Rel(endpoint, action, "Delegates")
Rel(action, model, "Applies rules")
Rel(action, db, "Reads or persists")
@enduml
