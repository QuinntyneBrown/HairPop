title Class structure — Recover account
class ResetCustomerPassword {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class PasswordReset {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): PasswordReset
  +save(record: PasswordReset): void
}
ResetCustomerPassword ..> FeatureRequest : accepts
ResetCustomerPassword ..> FeatureResult : returns
ResetCustomerPassword ..> FeatureRepository : uses
ResetCustomerPassword --> PasswordReset : checks or changes
FeatureRepository ..> PasswordReset : persists
