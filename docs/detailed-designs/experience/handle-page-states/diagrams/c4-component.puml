@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Handle page states
Container_Boundary(api, "HairPop API") {
  Component(endpoint, "Feature endpoint", "Laravel controller", "Validates HTTP input")
  Component(action, "ResolvePageState", "Application action", "Map loading, empty, partial, failed and unauthorized outcomes to safe actions")
  Component(model, "PageState", "Domain model", "Holds slice state")
  ComponentDb(db, "HairPop database", "<TO SUPPLY>", "Stores records")
}
Rel(endpoint, action, "Delegates")
Rel(action, model, "Applies rules")
Rel(action, db, "Reads or persists")
@enduml
