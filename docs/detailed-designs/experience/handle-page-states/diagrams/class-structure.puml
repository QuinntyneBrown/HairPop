@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Handle page states
class ResolvePageState {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class PageState {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): PageState

}
ResolvePageState ..> FeatureRequest : accepts
ResolvePageState ..> FeatureResult : returns
ResolvePageState ..> FeatureRepository : uses
ResolvePageState --> PageState : checks or changes
FeatureRepository ..> PageState : persists
@enduml
