@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Adapt accessible interface
class ResolveInterfacePreferences {
  +execute(request: FeatureRequest): FeatureResult
}
class FeatureRequest {
  +string actorId
  +string resourceId
}
class FeatureResult {
  +string status
  +string reference
}
class InterfacePreference {
  +string id
  +string status
}
interface FeatureRepository {
  +find(id: string): InterfacePreference

}
ResolveInterfacePreferences ..> FeatureRequest : accepts
ResolveInterfacePreferences ..> FeatureResult : returns
ResolveInterfacePreferences ..> FeatureRepository : uses
ResolveInterfacePreferences --> InterfacePreference : checks or changes
FeatureRepository ..> InterfacePreference : persists
@enduml
