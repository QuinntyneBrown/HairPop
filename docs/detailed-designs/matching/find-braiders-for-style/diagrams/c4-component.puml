@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Find braiders for style
Container_Boundary(api, "HairPop API") {
  Component(endpoint, "Feature endpoint", "Next.js route handler", "Validates HTTP input")
  Component(action, "FindEligibleBraiders", "Application action", "Match published offerings to the style and valid location and price filters")
  Component(model, "BraiderService", "Domain model", "Holds slice state")
  ComponentDb(db, "HairPop database", "PostgreSQL 16 (Prisma)", "Stores records")
}
Rel(endpoint, action, "Delegates")
Rel(action, model, "Applies rules")
Rel(action, db, "Reads or persists")
@enduml
