  {{themes}}{{icon:sparkle}}{{icon:calendar}}{{icon:map-pin}}{{icon:star}}<span style="color: var(--color-success-icon);">{{icon:check-circle}}</span><span style="color: var(--color-warning-icon);">{{icon:warning}}</span><span style="color: var(--color-danger-icon);">{{icon:alert-circle}}</span>{{/themes}}
